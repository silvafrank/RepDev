*.class
helpmenu.conf
repdev.conf

# Local run artifacts from the launcher's "start with logging" flow — these get
# repopulated with real session output (hostnames, usernames, stack traces) on
# every run, so they shouldn't be swept into a commit.
run_log.txt
stdout.txt
stderr.txt
/backup/


#ignore thumbnails created by windows
Thumbs.db
#Ignore files build by Visual Studio
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*_i.c
*_p.c
*.ncb
*.suo
*.tlb
*.tlh
*.bak
*.cache
*.ilk
*.log
[Bb]in
[Dd]ebug*/
*.lib
*.sbr
obj/
[Rr]elease*/
_ReSharper*/
[Tt]est[Rr]esult*
/dist/

# Gradle/Kotlin build output and caches (newdev/ module) — regenerated locally,
# can embed absolute local paths, shouldn't be committed.
newdev/**/build/
newdev/**/.gradle/

# Per-developer Gradle JDK toolchain override — hardcodes a local install path
# that won't exist on anyone else's machine.
newdev/gradle.properties
